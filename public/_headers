# Netlify & Modern Browser Caching Rules for KeepChat
# Ensure users always receive the latest version of the website

/*
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block

# Never cache HTML entry points - always revalidate so new bundles are loaded immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/tasks
  Cache-Control: public, max-age=0, must-revalidate

/settings
  Cache-Control: public, max-age=0, must-revalidate

/faq
  Cache-Control: public, max-age=0, must-revalidate

# Never cache Service Worker files
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/registerSW.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# Hashed assets are unique per build and can be cached immutably
/assets/*
  Cache-Control: public, max-age=31536000, immutable
